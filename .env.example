# Copy to .env.local for local development (npm run dev), or set these in Vercel → Project → Settings → Environment Variables.

# --- Logins (each password must be different, at least 8 characters) ---
COACH1_NAME=Coach A
COACH1_PASSWORD=change-me-coach-a
COACH2_NAME=Coach B
COACH2_PASSWORD=change-me-coach-b
STUDENT_NAME=Student
STUDENT_PASSWORD=change-me-student

# Long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Google Sheets (leave blank locally to use data/local-store.json) ---
GOOGLE_SHEET_ID=
# Paste the whole service-account JSON key file on one line:
GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Optional: n8n webhook called when the student submits an attempt ---
N8N_WEBHOOK_URL=
# Public URL of the app, used in the webhook's review link
APP_URL=
